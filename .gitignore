.env
.env.*
*.env
*.pem
*.key
*.p12
*.pfx
*credentials*.json
.DS_Store
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.cache/
runs/
dist/
build/
*.log
